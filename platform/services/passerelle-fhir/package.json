{
  "name": "@mbolo/passerelle-fhir",
  "version": "0.1.0",
  "private": true,
  "description": "Passerelle du dossier médical de Mbolo Santé : seul point d'entrée vers le serveur FHIR, contrôle des jetons de service et des permissions SMART, validation des écritures.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@mbolo/dossier-fhir": "workspace:*",
    "@mbolo/journal-securise": "workspace:*",
    "fastify": "^5.12.7",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/fhir": "^0.0.44"
  }
}
