  "browserFlow": "navigateur-mbolo",
  "authenticationFlows": [
    {
      "alias": "navigateur-mbolo",
      "description": "Connexion Mbolo Santé : session existante, ou formulaire + OTP pour les rôles à MFA obligatoire.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "navigateur-mbolo formulaires",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "navigateur-mbolo formulaires",
      "description": "Identifiant et mot de passe, puis MFA conditionnelle.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
