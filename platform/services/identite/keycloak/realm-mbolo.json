{
  "realm": "mbolo",
  "displayName": "Mbolo Santé",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient : accès à son propre dossier et à ses consentements."
      },
      {
        "name": "proche",
        "description": "Proche ou aidant (dont diaspora) : accès limité, uniquement avec un consentement C-PROCHE qui le désigne."
      },
      {
        "name": "professionnel",
        "description": "Professionnel de santé vérifié par un humain : accès au dossier avec consentement C-PARTAGE-PRO ou bris de glace motivé. MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "infirmier",
        "description": "Infirmier d'un point de consultation assistée. MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "pharmacien",
        "description": "Pharmacien partenaire : aucun accès au dossier (ordonnances via un service dédié). MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "administrateur",
        "description": "Administration technique : aucun accès aux données de santé. MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "agent-ia",
        "description": "Compte de service d'un agent IA : patient de la session uniquement, avec C-SOINS actif."
      },
      {
        "name": "mfa-requise",
        "description": "Rôle technique : impose la double authentification (OTP) à la connexion. Inclus dans professionnel, infirmier, pharmacien, administrateur. Ne jamais l'attribuer ni le retirer à la main."
      },
      {
        "name": "revue-acces",
        "description": "Relecteur des accès d'urgence : revoit les bris de glace (traces seulement), aucun accès clinique. MFA obligatoire. Attribué par un administrateur à la personne désignée par le porteur de projet.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "mbolo-app-patient",
      "name": "Application patient Mbolo Santé",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-identite-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mbolo-identite-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-teleconsultation-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mbolo-teleconsultation-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "patient_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "patient_id",
            "claim.name": "patient_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "related_person_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "related_person_id",
            "claim.name": "related_person_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "roles", "basic"],
      "optionalClientScopes": ["profile", "email"]
    },
    {
      "clientId": "mbolo-app-pro",
      "name": "Espace professionnels Mbolo Santé",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:5174/*"],
      "webOrigins": ["http://localhost:5174"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*"
      },
      "protocolMappers": [
        {
          "name": "audience-identite-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mbolo-identite-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-teleconsultation-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mbolo-teleconsultation-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "practitioner_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "practitioner_id",
            "claim.name": "practitioner_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "roles", "basic"],
      "optionalClientScopes": ["profile", "email"]
    },
    {
      "clientId": "mbolo-identite-api",
      "name": "API identité (ressource)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "mbolo-teleconsultation-api",
      "name": "API téléconsultation (ressource)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "mbolo-dossier-fhir",
      "name": "Passerelle du dossier médical (ressource)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "mbolo-identite-service",
      "name": "Compte de service du service identité (dossier : consentements et journal des accès)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${IDENTITE_SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "frontchannelLogout": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "audience-dossier-fhir",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mbolo-dossier-fhir",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "permissions-smart",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "mbolo_scopes",
            "claim.value": "system/Consent.crus system/AuditEvent.cs",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mbolo-teleconsultation-service",
      "name": "Compte de service du service téléconsultation (dossier : rendez-vous uniquement)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TELECONSULTATION_SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "frontchannelLogout": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "audience-dossier-fhir",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mbolo-dossier-fhir",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "permissions-smart",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "mbolo_scopes",
            "claim.value": "system/Appointment.crus system/Schedule.crus system/Slot.crus",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "browserFlow": "navigateur-mbolo",
  "authenticationFlows": [
    {
      "alias": "navigateur-mbolo",
      "description": "Connexion Mbolo Santé : session existante, ou formulaire + OTP pour les rôles à MFA obligatoire.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "navigateur-mbolo formulaires",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "navigateur-mbolo formulaires",
      "description": "Identifiant et mot de passe, puis MFA conditionnelle.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "navigateur-mbolo mfa",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "navigateur-mbolo mfa",
      "description": "OTP obligatoire pour les comptes portant le rôle mfa-requise (configuration imposée à la première connexion).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "role-mfa-requise",
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "role-mfa-requise",
      "config": {
        "condUserRole": "mfa-requise",
        "negate": "false"
      }
    }
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"patient_id\",\"displayName\":\"Identifiant FHIR Patient\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}},{\"name\":\"practitioner_id\",\"displayName\":\"Identifiant FHIR Practitioner\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}},{\"name\":\"related_person_id\",\"displayName\":\"Identifiant FHIR RelatedPerson\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}}]}"
          ]
        }
      }
    ]
  }
}
