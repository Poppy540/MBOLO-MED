{
  "realm": "mbolo",
  "displayName": "Mbolo Santé",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient : accès à son propre dossier et à ses consentements."
      },
      {
        "name": "proche",
        "description": "Proche ou aidant (dont diaspora) : accès limité, uniquement avec un consentement C-PROCHE qui le désigne."
      },
      {
        "name": "professionnel",
        "description": "Professionnel de santé vérifié par un humain : accès au dossier avec consentement C-PARTAGE-PRO ou bris de glace motivé. MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "infirmier",
        "description": "Infirmier d'un point de consultation assistée. MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "pharmacien",
        "description": "Pharmacien partenaire : aucun accès au dossier (ordonnances via un service dédié). MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "administrateur",
        "description": "Administration technique : aucun accès aux données de santé. MFA obligatoire.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "agent-ia",
        "description": "Compte de service d'un agent IA : patient de la session uniquement, avec C-SOINS actif."
      },
      {
        "name": "mfa-requise",
        "description": "Rôle technique : impose la double authentification (OTP) à la connexion. Inclus dans les rôles professionnels et habilités. Ne jamais l'attribuer ni le retirer à la main."
      },
      {
        "name": "revue-acces",
        "description": "Relecteur des accès d'urgence : revoit les bris de glace (traces seulement), aucun accès clinique. MFA obligatoire. Attribué par un administrateur à la personne désignée par le porteur de projet.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "gestion-invitations",
        "description": "Gestionnaire des invitations (ADR-0013) : crée et révoque les codes d'invitation, aucun accès clinique. MFA obligatoire. Attribué par un administrateur au porteur de projet et à la personne de confiance qu'il désigne ; jamais à un agent IA.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "verification-identite",
        "description": "Vérificateur d'identité (ADR-0015) : voit les photos d'identité (chaque ouverture est tracée) et décide ; aucun accès clinique. MFA obligatoire. Jamais un agent IA.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      },
      {
        "name": "validation-remboursement",
        "description": "Valide ou refuse les remboursements préparés par la plateforme (ADR-0017) : paiement reçu pour un rendez-vous annulé ; aucun accès clinique. MFA obligatoire. Jamais un agent IA ni le patient concerné.",
        "composite": true,
        "composites": {
          "realm": ["mfa-requise"]
        }
      }
    ]
  },
