{
  "name": "@mbolo/consultation",
  "version": "0.1.0",
  "private": true,
  "description": "Consultation clinique côté professionnel : lecture du dossier du patient après décision d'accès (consentement, bris de glace) et compte-rendu de téléconsultation rédigé par le professionnel.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@mbolo/dossier-fhir": "workspace:*",
    "@mbolo/identite": "workspace:*",
    "@mbolo/journal-securise": "workspace:*",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/fhir": "^0.0.41",
    "jose": "^6.2.12"
  }
}
