{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./secrets/local/**)",
      "Edit(./secrets/local/**)",
      "Write(./secrets/local/**)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Bash(cat ./secrets/local/:*)",
      "Bash(cat secrets/local/:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo rm:*)",
      "Bash(env:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(printenv)",
      "Bash(export -p)",
      "Bash(set)",
      "Bash(declare -x:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(vault kv get:*)",
      "Bash(vault read:*)",
      "Bash(doppler secrets:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(op read:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(go install:*)",
      "Bash(go get:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker push:*)",
      "Bash(rm:*)",
      "Bash(git branch -D:*)",
      "WebFetch",
      "WebSearch",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/agents/**)",
      "Write(./.claude/agents/**)",
      "Edit(./agents/*/permissions.md)",
      "Write(./agents/*/permissions.md)",
      "Edit(./agents/*/system-prompt.md)",
      "Write(./agents/*/system-prompt.md)",
      "Edit(./.gitleaks.toml)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./.gitignore)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(gitleaks:*)",
      "Bash(pre-commit run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx cucumber-js:*)",
      "Bash(pytest:*)",
      "Bash(semgrep:*)",
      "Bash(trivy fs:*)",
      "Bash(npm audit:*)"
    ]
  }
}
