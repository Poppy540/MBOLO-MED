# ─────────────────────────────────────────────────────────────
# Mbolo Santé — modèle de variables : WhatsApp Business API
# MODÈLE UNIQUEMENT. Aucune valeur réelle. Toutes les valeurs sont CHANGEME.
# Les valeurs réelles vivent dans le coffre-fort : mbolo/<env>/whatsapp/
# Inventaire complet : secrets/inventaire-cles.md
# ─────────────────────────────────────────────────────────────
# Une clé par agent, portée : messages du numéro Mbolo Santé uniquement.
WHATSAPP_PHONE_NUMBER_ID=CHANGEME
WHATSAPP_ACCESS_TOKEN_AGENT01=CHANGEME
WHATSAPP_ACCESS_TOKEN_AGENT02=CHANGEME
WHATSAPP_APP_SECRET=CHANGEME
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGEME
