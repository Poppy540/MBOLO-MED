# ─────────────────────────────────────────────────────────────
# Mbolo Santé — modèle de variables : paiement par carte (diaspora)
# MODÈLE UNIQUEMENT. Aucune valeur réelle. Toutes les valeurs sont CHANGEME.
# Les valeurs réelles vivent dans le coffre-fort : mbolo/<env>/paiement-carte/
# Inventaire complet : secrets/inventaire-cles.md
# ─────────────────────────────────────────────────────────────
# Utilisateur : Plateforme (service paiement).
CARD_PAYMENT_PUBLISHABLE_KEY=CHANGEME
CARD_PAYMENT_SECRET_KEY=CHANGEME
CARD_PAYMENT_WEBHOOK_SIGNING_SECRET=CHANGEME
# Utilisateur : Agent 2 — LECTURE SEULE du statut de paiement (aucune écriture, aucun remboursement).
PAYMENT_STATUS_READONLY_TOKEN_AGENT02=CHANGEME
