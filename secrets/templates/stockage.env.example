# ─────────────────────────────────────────────────────────────
# Mbolo Santé — modèle de variables : stockage des documents chiffrés
# MODÈLE UNIQUEMENT. Aucune valeur réelle. Toutes les valeurs sont CHANGEME.
# Les valeurs réelles vivent dans le coffre-fort : mbolo/<env>/stockage/
# Inventaire complet : secrets/inventaire-cles.md
# ─────────────────────────────────────────────────────────────
# Utilisateur : Plateforme uniquement. Chiffrement côté serveur avec clé gérée par un KMS.
STORAGE_ENDPOINT=https://CHANGEME.example
STORAGE_BUCKET=CHANGEME
STORAGE_ACCESS_KEY_ID=CHANGEME
STORAGE_SECRET_ACCESS_KEY=CHANGEME
STORAGE_KMS_KEY_REFERENCE=CHANGEME
