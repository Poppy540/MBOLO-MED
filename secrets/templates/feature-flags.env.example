# ─────────────────────────────────────────────────────────────
# Mbolo Santé — modèle de variables : feature flags
# MODÈLE UNIQUEMENT. Aucune valeur réelle. Toutes les valeurs sont CHANGEME.
# Les valeurs réelles vivent dans le coffre-fort : mbolo/<env>/feature-flags/
# Inventaire complet : secrets/inventaire-cles.md
# ─────────────────────────────────────────────────────────────
# Plateforme : évaluation des flags (SDK serveur).
FEATURE_FLAGS_SERVER_SDK_KEY=CHANGEME
# Agent 6 : lecture seule de l'état des flags. Aucune modification.
FEATURE_FLAGS_READONLY_KEY_PILOTE=CHANGEME
