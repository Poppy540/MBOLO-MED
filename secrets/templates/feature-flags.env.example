# ─────────────────────────────────────────────────────────────
# Mbolo Santé — modèle de variables : feature flags
# MODÈLE UNIQUEMENT. Aucune valeur réelle. Toutes les valeurs sont CHANGEME.
# Les valeurs réelles vivent dans le coffre-fort (Infisical, ADR-0005) : projet mbolo-sante / <env> / feature-flags/
# Inventaire complet : secrets/inventaire-cles.md
# ─────────────────────────────────────────────────────────────
# Outil : Unleash, via OpenFeature (ADR-0007).
UNLEASH_API_URL=https://CHANGEME.example/api
# Plateforme : jeton backend (évaluation seule).
UNLEASH_BACKEND_TOKEN=CHANGEME
# Agent 6 : compte de service LECTURE SEULE (rôle Viewer). Aucune modification.
UNLEASH_READONLY_TOKEN_PILOTE=CHANGEME
