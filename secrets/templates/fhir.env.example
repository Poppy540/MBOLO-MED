# ─────────────────────────────────────────────────────────────
# Mbolo Santé — modèle de variables : serveur FHIR (un compte par agent, droits minimaux)
# MODÈLE UNIQUEMENT. Aucune valeur réelle. Toutes les valeurs sont CHANGEME.
# Les valeurs réelles vivent dans le coffre-fort : mbolo/<env>/fhir/
# Inventaire complet : secrets/inventaire-cles.md
# ─────────────────────────────────────────────────────────────
FHIR_BASE_URL=https://CHANGEME.example/fhir
# Plateforme (service dossier-fhir)
FHIR_CLIENT_ID_PLATFORM=CHANGEME
FHIR_CLIENT_SECRET_PLATFORM=CHANGEME
# Agent 1 : création/lecture du dossier du patient en cours d'interaction uniquement
FHIR_CLIENT_ID_AGENT01=CHANGEME
FHIR_CLIENT_SECRET_AGENT01=CHANGEME
# Agent 2 : lecture MedicationRequest/Appointment/ServiceRequest du patient concerné
FHIR_CLIENT_ID_AGENT02=CHANGEME
FHIR_CLIENT_SECRET_AGENT02=CHANGEME
# Agent 4 : lecture de données PSEUDONYMISÉES uniquement (vue dédiée)
FHIR_CLIENT_ID_AGENT04=CHANGEME
FHIR_CLIENT_SECRET_AGENT04=CHANGEME
