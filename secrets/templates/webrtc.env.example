# ─────────────────────────────────────────────────────────────
# Mbolo Santé — modèle de variables : vidéo WebRTC (LiveKit, Jitsi ou équivalent)
# MODÈLE UNIQUEMENT. Aucune valeur réelle. Toutes les valeurs sont CHANGEME.
# Les valeurs réelles vivent dans le coffre-fort (Infisical, ADR-0005) : projet mbolo-sante / <env> / webrtc/
# Inventaire complet : secrets/inventaire-cles.md
# ─────────────────────────────────────────────────────────────
# Utilisateur : Plateforme (service téléconsultation) uniquement.
WEBRTC_SERVER_URL=wss://CHANGEME.example
WEBRTC_API_KEY=CHANGEME
WEBRTC_API_SECRET=CHANGEME
WEBRTC_TURN_SHARED_SECRET=CHANGEME
# Compte de service du service téléconsultation pour la passerelle du dossier (rendez-vous uniquement).
# Identifiant du client : mbolo-teleconsultation-service
TELECONSULTATION_SERVICE_CLIENT_SECRET=CHANGEME
